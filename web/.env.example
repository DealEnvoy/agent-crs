# Copy to web/.env.local. Never commit that file.
# Agent CRS signs only on testnet.

NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_CONTRACT_ID=vault.acrs261111k7m2.testnet
NEAR_OWNER_ACCOUNT_ID=acrs261111k7m2.testnet
NEAR_AGENT_ACCOUNT_ID=agent.acrs261111k7m2.testnet
NEAR_VENDOR_ACCOUNT_ID=vendor.acrs261111k7m2.testnet
NEAR_OTHER_ACCOUNT_ID=other.acrs261111k7m2.testnet

# Paths to near-cli credential JSON files. Do not paste private keys here.
NEAR_OWNER_CREDENTIALS_FILE=
NEAR_AGENT_CREDENTIALS_FILE=

# Optional. When unset, the offline parser is used and the UI says no model ran.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
